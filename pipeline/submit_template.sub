universe = vanilla
log = condor.log
error = condor.err
output = condor.out

executable = merge_reads.sh
arguments = {{ARGS}}

transfer_input_files = {{INPUT_FILES}}

initialdir = {{INITIALDIR}}

request_cpus = {{CPUS}}
request_memory = {{MEMORY}}
request_disk = {{DISK}}

# notify_email in params.env controls this: set to ERROR + your address if
# provided, otherwise NEVER (see process_ngs.sh). merge_reads.sh redirects
# almost all of its own output to run_progress.log, so condor.out/condor.err
# mainly catch failures that happen before that redirect takes effect.
notification = {{NOTIFICATION}}
notify_user = {{NOTIFY_USER}}

queue 1
