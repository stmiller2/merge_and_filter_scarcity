universe = vanilla
log = {{LOGDIR}}/condor.log
error = {{LOGDIR}}/condor.err
output = {{LOGDIR}}/condor.out

executable = merge_reads.sh
arguments = {{ARGS}}

transfer_input_files = {{INPUT_FILES}}

initialdir = {{INITIALDIR}}

request_cpus = {{CPUS}}
request_memory = {{MEMORY}}
request_disk = {{DISK}}

# notify_email in params.env controls this: set to ERROR + your address if
# provided, otherwise NEVER (see process_ngs.sh).
notification = {{NOTIFICATION}}
notify_user = {{NOTIFY_USER}}

queue 1
